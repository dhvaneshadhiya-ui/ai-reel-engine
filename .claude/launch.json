{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "public",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "http-server",
        "public",
        "-c-1"
      ],
      "autoPort": true
    },
    {
      "name": "remotion-studio",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "remotion",
        "studio",
        "src/index.ts",
        "--port",
        "3100",
        "--no-open"
      ],
      "port": 3100
    }
  ]
}
